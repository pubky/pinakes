{
  "openapi": "3.1.0",
  "info": {
    "title": "Pinakes",
    "description": "Pinakes ranks, Nexus hydrates. External resource metadata and search.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/dumps/osm_place.ndjson": {
      "get": {
        "tags": [],
        "operationId": "osm_dump",
        "responses": {
          "200": {
            "description": "Streaming ODbL derivative database; first line is the licence notice",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Dump request budget exhausted"
          }
        }
      }
    },
    "/v1/info": {
      "get": {
        "tags": [],
        "operationId": "info",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [],
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/resolve": {
      "post": {
        "tags": [],
        "operationId": "resolve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceView"
                }
              }
            }
          },
          "202": {
            "description": "Queued; poll resource by ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceView"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported URI or disabled resolver"
          },
          "429": {
            "description": "Preview rate limit"
          }
        }
      }
    },
    "/v1/resources/lookup": {
      "post": {
        "tags": [],
        "operationId": "lookup",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/Fields"
                }
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResourceView"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Exactly one list of 1–500 IDs or URIs"
          }
        }
      }
    },
    "/v1/resources/{id}": {
      "get": {
        "tags": [],
        "operationId": "resource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "32 lowercase hex resource ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/Fields"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID"
          },
          "404": {
            "description": "Unknown resource"
          }
        }
      }
    },
    "/v1/search": {
      "get": {
        "tags": [],
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "scheme",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "host",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "match",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "reach",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "viewer",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "facet",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/components/schemas/Fields"
                }
              ]
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "near",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "venue",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "collapse",
            "in": "query",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "304": {
            "description": "ETag unchanged"
          },
          "400": {
            "description": "Invalid or unavailable filter"
          },
          "502": {
            "description": "Nexus reach unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cluster": {
        "type": "object",
        "required": [
          "cell",
          "count",
          "lat",
          "lon",
          "top"
        ],
        "properties": {
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "cell": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          },
          "top": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ClusterResponse": {
        "type": "object",
        "required": [
          "clusters",
          "points",
          "truncated",
          "total",
          "reach_truncated"
        ],
        "properties": {
          "clusters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cluster"
            }
          },
          "facets": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Facets"
              }
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceView"
            }
          },
          "reach_truncated": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "Facets": {
        "type": "object",
        "required": [
          "tags"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagFacet"
            }
          }
        }
      },
      "Fields": {
        "type": "string",
        "enum": [
          "card",
          "facets",
          "document"
        ]
      },
      "LocationSource": {
        "type": "string",
        "enum": [
          "uri",
          "osm",
          "page",
          "geocoded"
        ]
      },
      "LookupRequest": {
        "type": "object",
        "properties": {
          "ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "uris": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "Point": {
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lon": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ResolveRequest": {
        "type": "object",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ResourceMeta": {
        "type": "object",
        "required": [
          "type",
          "type_path",
          "url",
          "site",
          "attributes",
          "source",
          "fetched_at",
          "status"
        ],
        "properties": {
          "address": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "bbox": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "fetched_at": {
            "type": "integer",
            "format": "int64"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ]
          },
          "location_source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LocationSource"
              }
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "osm_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "site": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "ttl_secs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "type": {
            "type": "string"
          },
          "type_path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          }
        }
      },
      "ResourceView": {
        "type": "object",
        "required": [
          "resource_id",
          "uri",
          "site",
          "status",
          "score"
        ],
        "properties": {
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "document": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ResourceMeta"
              }
            ]
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "osm_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "point": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Point"
              }
            ]
          },
          "resource_id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "site": {
            "type": "string"
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "type_path": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "uri": {
            "type": "string"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "items",
          "reach_truncated"
        ],
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "facets": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Facets"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceView"
            }
          },
          "reach_truncated": {
            "type": "boolean"
          }
        }
      },
      "SearchResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SearchResponse"
          },
          {
            "$ref": "#/components/schemas/ClusterResponse"
          }
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "ok",
          "pending",
          "missing",
          "unreachable",
          "error"
        ]
      },
      "TagFacet": {
        "type": "object",
        "required": [
          "label",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
