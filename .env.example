# Secrets and per-deployment overrides for pinakesd. Copy to .env, fill in what you use, and load
# it before starting the daemon (see "Configuration and secrets" in README.md). Every value here
# is a placeholder. Never commit .env.
#
# Any config key can be set as PINAKES__SECTION__KEY; the environment wins over the TOML file.
# Unknown keys stop startup.

# --- Database ---------------------------------------------------------------------------------
# The full connection URL, password included; it replaces database_url from the TOML file. A
# peer-authenticated Unix socket needs no password (postgresql:///pinakes?host=/var/run/postgresql).
# PINAKES__DATABASE_URL=postgresql://pinakes:change-me@db.example.internal:5432/pinakes

# --- Admin listener ---------------------------------------------------------------------------
# Bearer token for every admin route (metrics, operator info, the stored document, curation).
# Required when admin_listen is not a loopback address; recommended always. An empty token is
# refused at startup, so leave the line commented until it has a value (a long random string).
# PINAKES__ADMIN_TOKEN=change-me

# --- Nexus ------------------------------------------------------------------------------------
# A Nexus behind credentials: the whole value is sent as the Authorization header on every
# request to nexus_url, and to no other host. nexus_url itself never carries credentials. One
# underscore. Set empty, it clears a value the TOML file holds, so leave the line commented
# until it has one.
# PINAKES_NEXUS_AUTHORIZATION=Bearer change-me

# --- Nominatim --------------------------------------------------------------------------------
# A hosted Nominatim whose base URL carries its key (docs/deployment.md, "Nominatim"): the whole
# URL goes here, never in the TOML file, with the key in its path (user info, a query or a
# fragment is refused). A self-hosted Nominatim's URL can stay in the TOML file.
# PINAKES__OSM__NOMINATIM_URL=https://nominatim.example.org/change-me

# --- Event platform keys ----------------------------------------------------------------------
# Platforms that need an API key are off until their key is set (empty means no key); the others
# need none.
# Ticketmaster Discovery API
PINAKES__EVENT__ADAPTERS__PLATFORMS__TICKETMASTER__KEY=
# Skiddle
PINAKES__EVENT__ADAPTERS__PLATFORMS__SKIDDLE__KEY=
# Billetto
PINAKES__EVENT__ADAPTERS__PLATFORMS__BILLETTO_API__KEY=
# Eventfrog
PINAKES__EVENT__ADAPTERS__PLATFORMS__EVENTFROG_API__KEY=
# Google Calendar API (public calendars)
PINAKES__EVENT__ADAPTERS__PLATFORMS__GOOGLE_CALENDAR_API__KEY=

# --- Podcast Index ----------------------------------------------------------------------------
# The podcasts also-on source asks Podcast Index only with both (free from api.podcastindex.org).
PINAKES__PODCAST_INDEX__KEY=
PINAKES__PODCAST_INDEX__SECRET=

# --- TIDAL ------------------------------------------------------------------------------------
# The tidal also-on source (a TIDAL album's barcode, a track's ISRC) runs only with both: a TIDAL
# developer app's client ID and secret (developer.tidal.com). One underscore: a build without the
# source ignores them.
PINAKES_TIDAL_CLIENT_ID=
PINAKES_TIDAL_CLIENT_SECRET=

# --- Spotify ----------------------------------------------------------------------------------
# The spotify also-on source (a Spotify album's barcode, a track's ISRC) runs only with both: a
# Spotify app's client ID and secret (developer.spotify.com, client-credentials grant). One
# underscore: a build without the source ignores them.
PINAKES_SPOTIFY_CLIENT_ID=
PINAKES_SPOTIFY_CLIENT_SECRET=

# --- Discogs ----------------------------------------------------------------------------------
# A personal access token (discogs.com, Settings → Developers): Discogs cards then show images.
# Optional; empty means none. Sent only to api.discogs.com, never logged.
PINAKES__ALSO_ON__SOURCES__DISCOGS__TOKEN=
# Or a Discogs app's consumer key and secret (Settings → Developers → Create an application): the
# same 60 requests a minute and images. The token wins when both are set. One underscore.
PINAKES_DISCOGS_CONSUMER_KEY=
PINAKES_DISCOGS_CONSUMER_SECRET=

# --- GitHub -----------------------------------------------------------------------------------
# A fine-grained personal access token for public repositories, read-only, with no permissions:
# GitHub repository links then get cards from its API. Optional; without one they get web cards.
# Sent only to api.github.com, never logged.
PINAKES_GITHUB_TOKEN=

# --- CourtListener ----------------------------------------------------------------------------
# A CourtListener account's API token: court opinion links then get cards from its search API.
# Optional; without one they get web cards. Sent only to www.courtlistener.com, never logged.
PINAKES_COURTLISTENER_TOKEN=

# --- Logging ----------------------------------------------------------------------------------
# Log filter in tracing's EnvFilter syntax; logs are JSON lines on standard output. The default:
# RUST_LOG=pinakes=info,pinakes_core=info,sqlx=warn

# --- Contact ----------------------------------------------------------------------------------
# The address Pinakes gives the services it reads, in the User-Agent. Overrides [http] contact;
# empty turns it off (the links of sources that need it then wait).
# PINAKES__HTTP__CONTACT=operator@example.org

# --- Overrides (examples) ---------------------------------------------------------------------
# Any limit from docs/operations.md:
# PINAKES__LIMITS__RESOLVER_CONCURRENCY=8
# A per-host request rate (requests per second). The host name keeps its dots, which systemd
# EnvironmentFile= and --env-file accept but a shell cannot source; from a shell, set it in
# [limits.host_rates] in the TOML file instead.
# PINAKES__LIMITS__HOST_RATES__api.example.org=0.5
