{"data":[{"id":"10.48550/arxiv.1304.1068","type":"dois","attributes":{"doi":"10.48550/arxiv.1304.1068","identifiers":[{"identifier":"1304.1068","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"G.","familyName":"Kucsko","name":"Kucsko, G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. C.","familyName":"Maurer","name":"Maurer, P. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"N. Y.","familyName":"Yao","name":"Yao, N. Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Kubo","name":"Kubo, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. J.","familyName":"Noh","name":"Noh, H. J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"P. K.","familyName":"Lo","name":"Lo, P. K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H.","familyName":"Park","name":"Park, H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M. D.","familyName":"Lukin","name":"Lukin, M. D.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nanometer scale quantum thermometry in a living cell"}],"publisher":"arXiv","container":{},"publicationYear":2013,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Mesoscale and Nanoscale Physics (cond-mat.mes-hall)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optics (physics.optics)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2013-04-03T19:41:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2013-08-06T00:10:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2013-04","dateType":"Available","dateInformation":"v1"},{"date":"2013","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"ScholarlyArticle","resourceTypeGeneral":"Text","citeproc":"article-journal","bibtex":"article","ris":"RPRT","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/nature12373","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sensitive probing of temperature variations on nanometer scales represents an outstanding challenge in many areas of modern science and technology. In particular, a thermometer capable of sub-degree temperature resolution as well as integration within a living system could provide a powerful new tool for many areas of biological research, including temperature-induced control of gene expression and cell-selective treatment of disease. Here, we demonstrate a new approach to nanoscale thermometry that utilizes coherent manipulation of the electronic spin associated with nitrogen-vacancy (NV) color centers in diamond. We show the ability to detect temperature variations down to 1.8 mK (sensitivity of 9 mK/sqrt(Hz)) in an ultra-pure bulk diamond sample. Using NV centers in diamond nanocrystals (nanodiamonds), we directly measure the local thermal environment at length scales down to 200 nm. Finally, by introducing both nanodiamonds and gold nanoparticles into a single human embryonic fibroblast, we demonstrate temperature-gradient control and mapping at the sub-cellular level, enabling unique potential applications in life sciences."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/1304.1068","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2022-03-11T01:17:01Z","registered":"2022-03-11T01:17:02Z","published":null,"updated":"2022-03-11T01:17:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=relatedIdentifiers.relatedIdentifier:%2210.1038/nature12373%22%20AND%20relatedIdentifiers.relationType:IsVersionOf\u0026client-id=arxiv.content\u0026page%5Bsize%5D=25"}}