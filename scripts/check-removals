#!/usr/bin/env python3
"""check-removals [--tests] [NAME...]: prove each source goes by the checklist alone.

For every official source, also-on source and lookup family (every registered one, or the NAMEs
given), removes it on a scratch worktree of HEAD as AGENTS.md says (its module, its registry
lines, its docs page and index lines, its example-configuration blocks and variables, its fixture
directories, its own test file and its e2e samples), checks nothing of its own is left, and
builds every test target with warnings as errors. With `--tests`, it then runs the workspace's
tests (`cargo test --workspace`, as scripts/test does, every target even after one fails: set
DATABASE_URL and RUST_TEST_THREADS as for it), which a source's removal can break where the build
does not: a test of another source that relied on it, a recording it took along. A source whose
removal needs any other edit fails, with its first errors or failed tests. `--list` names the
sources and stops; `--self-test` checks the leftover check itself and stops.

The leftover check (`verify`) does not reuse the deletion's patterns: it looks for the source
where an id is an identifier, not a word. A link to its docs page anywhere; its module or path
in its registry; a section of the example configuration, parsed, or a section header set or
commented out; a variable of .env.example, set or commented out, and its banner; its id in
backticks in the docs index and the fixtures' indexes; its id as an identifier (backticks,
quotes, a path, a section) in scripts other than this one, which names in `SHARED` the ids
whose lines may stay. Those fail the source; its e2e samples are a file of its own, and the
shared samples name no source. Its id in backticks (as prose names a source) and its display
name as a word anywhere else (docs/, README.md, AGENTS.md, e2e/README.md, and the comments of
the files above) are reported for a reader, not failed: display names are services' names,
which describe other sources' links and the services themselves as often as the source, and
only a reader can tell. `SHARED` names the lines that may stay, each with its reason.

A fixture directory named after a source (`tests/fixtures/{sources,media,lookups}/<name>/`) is
that source's and goes with it; recordings several modules read are in a `shared/` directory,
which no source may be named.

Builds share CARGO_TARGET_DIR (set it; else the repository's own target directory is used). The
build takes about half a minute per source, the tests some minutes more: run it for the sources a
change touches, or everything before a release. Exit status 1 when any source fails.
"""
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CORE = "crates/pinakes-core/"
MODULE = {"sources": "src/sources/%s.rs", "also_on": "src/also_on/%s.rs", "lookups": "src/lookups/%s.rs"}
REGISTRY = {"sources": "src/sources/mod.rs", "also_on": "src/also_on.rs", "lookups": "src/lookups/mod.rs"}
# The indexes of the recorded fixtures: a source's fixtures are described by its own
# `provenance.json`, never here.
FIXTURE_INDEXES = [CORE + "tests/fixtures/%s/README.md" % d for d in ("sources", "media", "lookups")]
# The prose a reader is pointed to when it names a removed source.
PROSE = ["README.md", "AGENTS.md", "e2e/README.md"]
# Lines that may name a source after its removal, each with its reason: what they belong to is in
# the build without the source.
SHARED = [
    # `podcast_index_api.rs`: the Podcast Index key and secret, which the podcast_index source and
    # the podcasts also-on source both use; removing one leaves the other needing them.
    (re.compile(r"PODCAST_INDEX__(KEY|SECRET)|Podcast Index"), "the shared Podcast Index client's key and secret (podcast_index_api.rs)"),
    # The papers family's own huggingface source (a paper's Hugging Face page) shares its id with
    # the official huggingface source (model and dataset pages); the family's index entry names
    # its own.
    (re.compile(r"^- \[`papers`\]\(papers\.md\):.*`huggingface`"), "the papers family's own source of that id"),
]


def read(path):
    with open(os.path.join(ROOT, path), encoding="utf-8") as f:
        return f.read()


def registered():
    """(kind, module) for every entry of the three registries, in their order."""
    out = []
    text = read(CORE + REGISTRY["sources"])
    block = text[text.index("pub static REGISTRY") :]
    out += [("sources", m) for m in re.findall(r"^\s*&(\w+)::", block[: block.index("];")], re.M)]
    text = read(CORE + REGISTRY["also_on"])
    block = text[text.index("pub fn registry()") :]
    block = block[: block.index("\n}\n")]
    # `Arc::new(crate::sources::…)`: an official source's also-on half, removed with that source.
    out += [("also_on", m) for m in re.findall(r"Arc::new\((\w+)::", block) if m not in ("crate", "super")]
    text = read(CORE + REGISTRY["lookups"])
    block = text[text.index("pub static FAMILIES") :]
    out += [("lookups", m) for m in re.findall(r"^\s*&(\w+)::", block[: block.index("];")], re.M)]
    return out


def display_name(wt, name):
    """The source's display name, the title of its docs page (`# Discogs`): None when the page
    is titled by the id (`# \\`tidal\\`: …`) or missing."""
    p = os.path.join(wt, "docs/sources/%s.md" % name)
    if not os.path.exists(p):
        return None
    with open(p, encoding="utf-8") as f:
        title = f.readline().strip().lstrip("#").strip()
    return None if not title or title.startswith("`") else title


def own_lines(kind, name, title):
    """The patterns of a source's own lines in the shared files, by name: what `remove` deletes."""
    upper = name.upper()
    banner = "|".join(re.escape(t) for t in (name, title) if t)
    own = {
        CORE + REGISTRY[kind]: [r"^pub mod %s;\n" % name, r"^\s*(&%s::\w+,|Arc::new\(%s::\w+\),)\n" % (name, name)],
        # Its index entries (the page's, and `name.md#also-on` for an official source's half).
        "docs/sources/README.md": [r"^- \[`%s`\]\(%s\.md(?:#[^)]*)?\):[^\n]*\n(  [^\n]*\n)*" % (name, name)],
        "pinakes.example.toml": [
            # Its `[sources.<name>]` block (the header may carry a comment), to the next section or
            # blank line.
            r"^\[sources\.%s\][^\n]*\n(?:[^\[\n][^\n]*\n)*" % name,
            # Its `[also_on.sources.<id>]` block, set or commented out: the header and the comment or
            # key lines under it, to the next section or blank line.
            r"^#?\s*\[also_on\.sources\.%s\][^\n]*\n(?:(?!#?\s*\[)[^\n]+\n)*" % name,
            # Its own section (`[<name>]`), with the comment paragraph above it.
            r"(?:^#[^\n]*\n)*\n?^\[%s\][^\n]*\n(?:[^\[\n][^\n]*\n)*" % name,
        ],
        # Its banner paragraph (`# --- Name ---` to the blank line) and its variables: its own
        # (`PINAKES_NAME_TOKEN`) and the `PINAKES__SOURCES__NAME__…` and
        # `PINAKES__ALSO_ON__SOURCES__NAME__…` forms.
        ".env.example": [
            r"(?i)^# --- (?:%s) -+\n(?:[^\n]+\n)*" % banner,
            r"^PINAKES_{1,2}(?:(?:ALSO_ON__)?SOURCES__)?%s_{1,2}\w*=[^\n]*\n" % upper,
        ],
    }
    if kind == "sources":
        # An official source's also-on half (`Arc::new(crate::sources::<name>::…)`) goes with it.
        own.setdefault(CORE + REGISTRY["also_on"], []).append(r"^\s*Arc::new\(crate::sources::%s::[\w:]+\),\n" % name)
    return own


def own_paths(kind, name):
    """The files and directories that are a source's own: its module, docs page, fixture
    directories (those named after it; shared recordings are in `shared/`), own test files and
    e2e samples."""
    return [
        CORE + MODULE[kind] % name,
        "docs/sources/%s.md" % name,
        *(CORE + d + name for d in ("tests/fixtures/sources/", "tests/fixtures/media/", "tests/fixtures/lookups/")),
        *(CORE + t % name for t in ("tests/%s.rs", "tests/also_on_%s.rs")),
        "e2e/samples/%s.json" % name,
    ]


def remove(wt, kind, name):
    """Delete the source's own files and lines in the worktree `wt`, as the checklist says. The
    module and its registry lines must be there; the rest is deleted when present."""

    def rm(rel):
        p = os.path.join(wt, rel)
        if os.path.isdir(p):
            shutil.rmtree(p)
        elif os.path.exists(p):
            os.remove(p)
        else:
            return False
        return True

    def edit(rel, pattern):
        """Delete every match of `pattern` in the file: how many there were."""
        p = os.path.join(wt, rel)
        with open(p, encoding="utf-8") as f:
            s = f.read()
        t, n = re.subn(pattern, "", s, flags=re.M)
        if n:
            with open(p, "w", encoding="utf-8") as f:
                f.write(t)
        return n

    title = display_name(wt, name)
    if not rm(CORE + MODULE[kind] % name):
        raise SystemExit(f"{name}: no module {MODULE[kind] % name}")
    for rel in own_paths(kind, name)[1:]:
        rm(rel)
    lines = own_lines(kind, name, title)
    for pattern in lines.pop(CORE + REGISTRY[kind]):
        if edit(CORE + REGISTRY[kind], pattern) != 1:
            raise SystemExit(f"{name}: {REGISTRY[kind]} has no line matching {pattern!r}")
    for rel, patterns in lines.items():
        for pattern in patterns:
            edit(rel, pattern)


def names_source(line, name, title):
    """Whether the line names the source: its id in backticks (as prose names a source), or its
    display name as a whole word."""
    if "`%s`" % name in line:
        return True
    return bool(title) and re.search(r"(?<![\w-])%s(?![\w-])" % re.escape(title), line) is not None


def shared(line):
    """The reason a line that names a source may stay, or None."""
    return next((why for pattern, why in SHARED if pattern.search(line)), None)


def files_under(wt, rel):
    p = os.path.join(wt, rel)
    if os.path.isfile(p):
        yield rel
        return
    for root, dirs, files in os.walk(p):
        dirs[:] = sorted(d for d in dirs if d not in (".git", "target", "node_modules"))
        for f in sorted(files):
            yield os.path.relpath(os.path.join(root, f), wt)


def text_lines(wt, rel):
    try:
        with open(os.path.join(wt, rel), encoding="utf-8") as f:
            return list(enumerate(f.read().splitlines(), 1))
    except (UnicodeDecodeError, OSError):
        return []


def verify(wt, kind, name, title):
    """What the removal left of the source: (leftovers, mentions). Independent of `remove`: it
    looks for the source as an identifier (the module doc says where), not for what the
    deletion's patterns match. The mentions are its id and display name as words elsewhere, for
    a reader."""
    q = re.escape(name)
    left = [rel for rel in own_paths(kind, name) if os.path.exists(os.path.join(wt, rel))]

    def found(rel, i, what):
        left.append(f"{rel}:{i}: {what}")

    # Its registry: its module declared, or its module's path (`name::`, not `hubs::name::`).
    for i, l in text_lines(wt, CORE + REGISTRY[kind]):
        if re.search(r"^\s*pub mod %s;|(?<![\w:])%s::" % (q, q), l) and not shared(l):
            found(CORE + REGISTRY[kind], i, l.strip())
    # A link to its docs page from anywhere (the index entry, another page, a README).
    link = re.compile(r"\]\([^)]*(?<![\w-])%s\.md(?:#[^)]*)?\)" % q)
    for rel in files_under(wt, "."):
        if rel.endswith(".md"):
            for i, l in text_lines(wt, rel):
                if link.search(l):
                    found(rel, i, "links to its page: " + l.strip())
    # The example configuration: no section is the source's, parsed, nor a header set or
    # commented out.
    with open(os.path.join(wt, "pinakes.example.toml"), "rb") as f:
        config = tomllib.load(f)
    for path in (("sources", name), ("also_on", "sources", name), (name,)):
        table = config
        for key in path:
            table = table.get(key) if isinstance(table, dict) else None
        if table is not None:
            left.append("pinakes.example.toml: section [%s]" % ".".join(path))
    for i, l in text_lines(wt, "pinakes.example.toml"):
        if re.match(r"\s*#?\s*\[(?:[\w-]+\.)*%s\]" % q, l):
            found("pinakes.example.toml", i, "section header " + l.strip())
    # .env.example: no variable, set or commented out, is the source's; nor a banner.
    for i, l in text_lines(wt, ".env.example"):
        m = re.match(r"\s*#?\s*([A-Z][A-Z0-9_]*)=", l)
        if m and re.search(r"(?:^|_)%s(?:_|$)" % re.escape(name.upper()), m.group(1)) and not shared(l):
            found(".env.example", i, "variable " + m.group(1))
        if re.match(r"# --- (?:%s) -" % "|".join(re.escape(w) for w in (name, title) if w), l, re.I) and not shared(l):
            found(".env.example", i, "banner " + l.strip())
    # The docs index and the fixtures' indexes: its id in backticks.
    for rel in ["docs/sources/README.md", *FIXTURE_INDEXES]:
        for i, l in text_lines(wt, rel):
            if re.search(r"`%s`" % q, l) and not shared(l):
                found(rel, i, l.strip())
    # Scripts: its id as an identifier. Not this script, whose SHARED table names ids.
    for rel in files_under(wt, "scripts"):
        if rel == "scripts/check-removals":
            continue
        for i, l in text_lines(wt, rel):
            if re.search(r"`%s`|[\"']%s[\"']|/%s/|(?<![\w-])%s\.(?:md|json|rs)\b|\[(?:[\w-]+\.)*%s\]" % (q, q, q, q, q), l) and not shared(l):
                found(rel, i, l.strip())
    # Its id in backticks and its display name, elsewhere: for a reader.
    mentions = []
    for rel in [*PROSE, *files_under(wt, "docs"), "pinakes.example.toml", ".env.example"]:
        if rel.endswith((".md", ".toml", ".example")):
            for i, l in text_lines(wt, rel):
                line = f"{rel}:{i}: {l.strip()}"
                if names_source(l, name, title) and not shared(l) and line not in left and f"{rel}:{i}: links to its page: {l.strip()}" not in left:
                    mentions.append(line)
    return sorted(set(left)), mentions


def failures(output):
    """The lines that say what failed: compile errors and their places, failed tests and where
    they panicked."""
    keep = []
    for line in output.splitlines():
        l = line.strip()
        if (
            line.startswith("error")
            or l.startswith("-->")
            or (l.startswith("test ") and l.endswith("FAILED"))
            or " panicked at " in l
        ):
            keep.append(l)
    return keep


def worktree():
    wt = tempfile.mkdtemp(prefix="check-removal-")
    os.rmdir(wt)
    subprocess.run(["git", "worktree", "add", "-q", "--detach", wt, "HEAD"], cwd=ROOT, check=True)
    return wt


def drop_worktree(wt):
    subprocess.run(["git", "worktree", "remove", "--force", wt], cwd=ROOT, check=False)


def check(kind, name, tests):
    wt = worktree()
    try:
        title = display_name(wt, name)
        remove(wt, kind, name)
        left, mentions = verify(wt, kind, name, title)
        if left:
            return "the removal left:\n" + "\n".join(left), mentions
        env = dict(os.environ)
        env.setdefault("CARGO_TARGET_DIR", os.path.join(ROOT, "target"))
        steps = [["cargo", "clippy", "-q", "--all-targets", "--", "-D", "warnings"]]
        if tests:
            # Every target runs, so one run names everything the removal broke.
            steps.append(["cargo", "test", "-q", "--workspace", "--no-fail-fast"])
        for step in steps:
            run = subprocess.run(step, cwd=wt, env=env, capture_output=True, text=True)
            if run.returncode != 0:
                output = run.stderr + run.stdout
                return "\n".join(failures(output)[:16]) or output[-2000:], mentions
        return None, mentions
    finally:
        drop_worktree(wt)


def self_test():
    """The leftover check catches what the deletion's patterns would not. For every official
    source with an also-on half (ids of one word and of two): a clean removal verifies clean;
    its index entry put back as the also-on half's (`name.md#also-on`), its section put back with
    a trailing comment (`[sources.name] # Name`), and its banner and variable put back in
    .env.example are each named."""
    halves = read(CORE + REGISTRY["also_on"])
    names = [n for k, n in registered() if k == "sources" and "crate::sources::%s::" % n in halves]
    assert names, "no official source has an also-on half"
    for name in names:
        self_test_on(name)
    print("self-test ok (%s)" % ", ".join(names))
    return 0


def self_test_on(name):
    wt = worktree()
    try:
        title = display_name(wt, name) or name
        remove(wt, "sources", name)
        left, _ = verify(wt, "sources", name, title)
        assert not left, f"{name} removed: {left}"
        cases = [
            ("docs/sources/README.md", "- [`%s`](%s.md#also-on): its keys.\n" % (name, name), "links to its page"),
            ("pinakes.example.toml", "\n[sources.%s] # %s\nenabled = true\n" % (name, title), "section [sources.%s]" % name),
            (".env.example", "\n# --- %s ---\n# Its token.\nPINAKES_%s_TOKEN=\n" % (title, name.upper()), "variable PINAKES_%s_TOKEN" % name.upper()),
        ]
        for rel, text, expected in cases:
            p = os.path.join(wt, rel)
            with open(p, encoding="utf-8") as f:
                before = f.read()
            with open(p, "a", encoding="utf-8") as f:
                f.write(text)
            left, _ = verify(wt, "sources", name, title)
            assert any(expected in l for l in left), f"{rel}: {text!r} not named; left: {left}"
            with open(p, "w", encoding="utf-8") as f:
                f.write(before)
    finally:
        drop_worktree(wt)


def main(argv):
    all_sources = registered()
    if "shared" in {n for _, n in all_sources}:
        raise SystemExit("no source may be named `shared`: that is the fixtures' shared directory")
    if argv == ["--list"]:
        for kind, name in all_sources:
            print(f"{kind} {name}")
        return 0
    if argv == ["--self-test"]:
        return self_test()
    tests = "--tests" in argv
    names = [a for a in argv if a != "--tests"]
    chosen = all_sources if not names else [(k, n) for k, n in all_sources if n in names]
    missing = set(names) - {n for _, n in chosen}
    if missing:
        raise SystemExit("not registered: " + ", ".join(sorted(missing)))
    failed = 0
    for kind, name in chosen:
        started = time.monotonic()
        error, mentions = check(kind, name, tests)
        took = f"{time.monotonic() - started:.0f} s"
        if error is None:
            print(f"{name}: ok ({took})", flush=True)
        else:
            failed += 1
            print(f"{name}: FAIL ({took})\n" + "\n".join("  " + l for l in error.splitlines()), flush=True)
        if mentions:
            shown = "".join("\n    " + m for m in mentions[:8]) + ("\n    …" if len(mentions) > 8 else "")
            print(f"  {len(mentions)} line(s) of prose name it, for a reader:{shown}", flush=True)
    print(f"{len(chosen) - failed} of {len(chosen)} sources remove cleanly" + (" (build and tests)" if tests else " (build)"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
