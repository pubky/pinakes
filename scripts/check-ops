#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
pinakes_promtool="${PROMTOOL:-promtool}"
if command -v "$pinakes_promtool" >/dev/null 2>&1; then
  "$pinakes_promtool" check rules ops/alerts.yml
elif [[ -x .runtime/promtool/extracted/usr/bin/promtool ]]; then
  .runtime/promtool/extracted/usr/bin/promtool check rules ops/alerts.yml
else
  printf '%s\n' 'promtool unavailable; the workspace ops test parses YAML and checks every metric reference.'
fi
