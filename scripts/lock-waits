#!/usr/bin/env bash
# lock-waits COMMAND...: run COMMAND while sampling the Postgres server of $DATABASE_URL every
# 50 ms for backends waiting on a lock, then print how many samples saw a wait and which locks
# were waited for. Locks are named in that database (other databases' rows count as "row"). A
# search-revision wait is named by its lock (a row or relation lock of search_write or its
# sequence, or a row lock of search_write held while waiting for the row's transaction; in this
# database, as relation OIDs are per database), never by a statement's text, which
# pg_stat_activity can show stale beside a live wait.
# A sampler that could not connect, or stopped, fails the run: no samples never reads as no
# waits. Its messages are this script's own: psql's stderr is never read, since psql and libpq
# quote parts of the URL (a password, a host with a line break in it) in their errors.
# For example, around a re-index:
#   DATABASE_URL=... scripts/lock-waits pinakesd reextract web
set -uo pipefail
: "${DATABASE_URL:?set DATABASE_URL}"
[[ $# -gt 0 ]] || { echo "usage: scripts/lock-waits COMMAND..." >&2; exit 2; }
out=$(mktemp)
why=$(mktemp)
trap 'rm -f "$out" "$why"' EXIT
# psql connects by the PG* variables libpq parses DATABASE_URL into, so the URL (and any
# password in it) never stands on a command line, where the process table shows it. Why the
# URL can't be used goes to the file named first, in this script's words.
from_env='
import ctypes, ctypes.util, os, sys
class Option(ctypes.Structure):
    _fields_ = [(n, ctypes.c_char_p) for n in ("keyword", "envvar", "compiled", "val", "label", "dispchar")] + [("dispsize", ctypes.c_int)]
def refuse(reason):
    with open(sys.argv[1], "w") as why:
        why.write(reason)
    sys.exit(1)
pq = ctypes.CDLL(ctypes.util.find_library("pq") or "libpq.so.5")
pq.PQconninfoParse.restype = ctypes.POINTER(Option)
pq.PQconninfoParse.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_char_p)]
error = ctypes.c_char_p()
options = pq.PQconninfoParse(os.environ["DATABASE_URL"].encode(), ctypes.byref(error))
if not options:
    # Not libpq'"'"'s message: it quotes the token it could not read, which may be a password.
    refuse("DATABASE_URL is not a connection string libpq can read")
i = 0
while options[i].keyword:
    o = options[i]
    if o.val is not None:
        if not o.envvar:
            # The keyword is from libpq'"'"'s table of parameters, not from the URL.
            refuse("DATABASE_URL sets %s, which libpq reads from no environment variable" % o.keyword.decode())
        os.environ[o.envvar.decode()] = o.val.decode()
    i += 1
os.execvp(sys.argv[2], sys.argv[2:])
'
query="SELECT 'sample '||count(*) FILTER (WHERE wait_event_type='Lock') FROM pg_stat_activity WHERE pid<>pg_backend_pid();
WITH locks AS MATERIALIZED (SELECT * FROM pg_locks),
  db AS (SELECT oid FROM pg_database WHERE datname=current_database())
SELECT 'lock '||CASE
  WHEN l.locktype='advisory' THEN CASE l.objid WHEN 73822920 THEN 'write order' WHEN 73822917 THEN 'instance' WHEN 73822919 THEN 'alias' WHEN 73822918 THEN 'change sequence' WHEN 73491620 THEN 'group' WHEN 73822916 THEN 'ingest' ELSE 'advisory (adapter or parent)' END
  WHEN (l.locktype IN ('relation','page','tuple') AND l.database=(SELECT oid FROM db)
        AND l.relation IN (to_regclass('search_write'), to_regclass('search_write_id_seq')))
    OR EXISTS(SELECT 1 FROM locks t WHERE t.pid=l.pid AND t.granted AND t.locktype='tuple'
        AND t.database=(SELECT oid FROM db) AND t.relation=to_regclass('search_write')) THEN 'search revision'
  WHEN l.locktype IN ('transactionid','tuple') THEN 'row'
  ELSE l.locktype END
FROM locks l WHERE NOT l.granted AND l.pid<>pg_backend_pid();"
(while :; do echo "$query"; sleep 0.05; done) | python3 -I -c "$from_env" "$why" psql -XAtq -v ON_ERROR_STOP=1 > "$out" 2>/dev/null &
sampler=$!
start=$(date +%s%N)
"$@"
status=$?
end=$(date +%s%N)
kill "$sampler" 2>/dev/null
# 143: still sampling when stopped here (SIGTERM). Anything else: psql ended by itself, unable
# to connect, or on an error (ON_ERROR_STOP), or the URL was refused.
wait "$sampler" 2>/dev/null
sampler_status=$?
samples=$(grep -c '^sample ' "$out")
reason=
if [[ -s $why ]]; then
  reason=$(head -c 300 "$why")
elif [[ $sampler_status -ne 143 && $samples -eq 0 ]]; then
  reason="cannot connect to the database (check DATABASE_URL)"
elif [[ $sampler_status -ne 143 ]]; then
  reason="the sampler lost the database after $samples samples"
elif [[ $samples -eq 0 ]]; then
  reason="COMMAND ended before the first sample"
fi
if [[ -n $reason ]]; then
  echo "lock-waits: $reason" >&2
  echo "lock-waits: no count of lock waits" >&2
  [[ $status -ne 0 ]] && exit "$status"
  exit 1
fi
awk -v secs="$(( (end - start) / 1000000 ))" '
  /^sample / { samples++; if ($2 > 0) waiting++ }
  /^lock / { sub(/^lock /, ""); by[$0]++ }
  END {
    printf "%.1f s, %d samples, %d with a lock wait\n", secs / 1000, samples, waiting
    for (k in by) printf "  %6d  %s\n", by[k], k
  }' "$out" >&2
exit "$status"
