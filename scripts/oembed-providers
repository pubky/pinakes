#!/usr/bin/env python3
"""Replace the pinned oEmbed registry (data/oembed-providers.json) with a newer copy, for review.

Usage: scripts/oembed-providers [FILE]
Without FILE it downloads https://oembed.com/providers.json. It checks the shape, prints which
providers were added and removed, writes the file byte for byte, and updates the date, count and
SHA-256 in data/README.md. Review the diff, then run scripts/test: the registry is compiled in, and
providers skipped in code (cards::SKIPPED_PROVIDERS) stay skipped.
"""
import datetime, hashlib, json, pathlib, re, sys, urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
TARGET = ROOT / "data/oembed-providers.json"
README = ROOT / "data/README.md"
URL = "https://oembed.com/providers.json"

if len(sys.argv) > 1:
    raw = pathlib.Path(sys.argv[1]).read_bytes()
else:
    request = urllib.request.Request(URL, headers={"User-Agent": "pinakes-maintainer (+https://pubky.app)"})
    raw = urllib.request.urlopen(request, timeout=30).read()

providers = json.loads(raw)
assert isinstance(providers, list) and len(providers) >= 300, "not the provider registry"
for p in providers:
    assert isinstance(p.get("provider_name"), str) and p["provider_name"], p
    for e in p.get("endpoints", []):
        assert isinstance(e.get("url"), str) and e["url"].startswith("http"), (p["provider_name"], e)
        assert all(isinstance(s, str) for s in e.get("schemes", [])), (p["provider_name"], e)

old = {p["provider_name"] for p in json.loads(TARGET.read_bytes())}
new = {p["provider_name"] for p in providers}
print(f"{len(providers)} providers; added: {sorted(new - old) or 'none'}; removed: {sorted(old - new) or 'none'}")

TARGET.write_bytes(raw)
digest = hashlib.sha256(raw).hexdigest()
text = README.read_text()
text, n = re.subn(
    r"`oembed-providers\.json` pins the \d+-provider registry downloaded from\n<https://oembed\.com/providers\.json> on \d{4}-\d{2}-\d{2}\. SHA-256:\n`[0-9a-f]{64}`",
    f"`oembed-providers.json` pins the {len(providers)}-provider registry downloaded from\n"
    f"<https://oembed.com/providers.json> on {datetime.date.today().isoformat()}. SHA-256:\n`{digest}`",
    text,
)
assert n == 1, "data/README.md: the oEmbed paragraph moved; update it by hand"
README.write_text(text)
print(f"SHA-256 {digest}; data/README.md updated. Review the diff, then run scripts/test.")
