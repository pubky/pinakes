#!/usr/bin/env python3
"""Regenerate the pinned Rails display-name map; never fetch at runtime."""
import hashlib, json, pathlib, re, sys
raw = pathlib.Path(sys.argv[1]).read_bytes()
assert hashlib.sha256(raw).hexdigest() == "c20a9fb54a413919aa8944649d7424e6dbc1e4b5c95cd02a1b169682bfbb0285", "wrong Rails source release"
block = raw.decode().split("MAPPING = {", 1)[1].split("\n    }", 1)[0]
mapping = dict(re.findall(r'"([^"\n]+)"\s*=>\s*"([^"\n]+)"', block))
pathlib.Path(__file__).resolve().parent.parent.joinpath("data/rails-zones.json").write_text(json.dumps(mapping, sort_keys=True, indent=2)+"\n")
