#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export DATABASE_URL="${DATABASE_URL:-postgresql:///postgres?host=/var/run/postgresql}"
# The tests that run scripts/verify-osm-boundary need these tools; under this script they fail
# without them (a bare `cargo test` skips them with a message).
export PINAKES_REQUIRE_BOUNDARY_TOOLS=1
missing=""
for tool in psql pg_dump rg; do
  command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
  echo "WARNING: not installed:$missing; the scripts/verify-osm-boundary tests will fail" >&2
fi
cargo fmt --all -- --check
cargo clippy --all-targets -- -D warnings
cargo test --workspace
scripts/check-ops
