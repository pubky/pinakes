#!/usr/bin/env bash
# Called only after both native platform publications succeed on an authorized tag.
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && "${GITHUB_EVENT_NAME:-}" == push && "${GITHUB_REF_TYPE:-}" == tag ]]
# release-on-main's peeled commit (never an annotated tag's object) and this run's ID: the
# platform tags this run pushed and smoke-tested, which no other run writes.
[[ "${RELEASE_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]
[[ "${GITHUB_RUN_ID:-}" =~ ^[0-9]+$ ]]
[[ "$RELEASE_IMAGE_TAG" =~ ^v[0-9A-Za-z._-]+$ && ${#RELEASE_IMAGE_TAG} -le 128 ]]
[[ "$RELEASE_LATEST" == true || "$RELEASE_LATEST" == false ]]
image=ghcr.io/pubky/pinakes
# The index names its repository, so the package page links to it.
annotation=(--annotation "index:org.opencontainers.image.source=https://github.com/pubky/pinakes")
platforms=("$image:$RELEASE_COMMIT-$GITHUB_RUN_ID-amd64" "$image:$RELEASE_COMMIT-$GITHUB_RUN_ID-arm64")
tags=(--tag "$image:$RELEASE_IMAGE_TAG" --tag "$image:$RELEASE_COMMIT")
if [[ "$RELEASE_LATEST" == true ]]; then
  tags+=(--tag "$image:latest")
fi
validate_manifest() {
  python3 - "$1" <<'PY'
import json
import sys
with open(sys.argv[1]) as f:
    manifest = json.load(f)
platforms = {item['platform']['architecture'] for item in manifest['manifests']
             if item.get('platform', {}).get('os') == 'linux'}
assert platforms == {'amd64', 'arm64'}, platforms
PY

}
# Check both architectures before moving any version, SHA or latest tag.
docker buildx imagetools create --dry-run "${annotation[@]}" "${platforms[@]}" > "$RUNNER_TEMP/pinakes-candidate-manifest.json"
validate_manifest "$RUNNER_TEMP/pinakes-candidate-manifest.json"
docker buildx imagetools create "${annotation[@]}" "${tags[@]}" "${platforms[@]}"
docker buildx imagetools inspect --raw "$image:$RELEASE_IMAGE_TAG" > "$RUNNER_TEMP/pinakes-release-manifest.json"
validate_manifest "$RUNNER_TEMP/pinakes-release-manifest.json"
