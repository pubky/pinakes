#!/usr/bin/env python3
"""Classify a v-prefixed SemVer tag before any registry login or publication."""
import re
import sys

number = r'(?:0|[1-9][0-9]*)'
# Numeric prerelease identifiers cannot have leading zeroes; alphanumeric ones can.
prerelease_id = rf'(?:{number}|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)'
pattern = rf'v{number}\.{number}\.{number}(?P<pre>-{prerelease_id}(?:\.{prerelease_id})*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?'
match = re.fullmatch(pattern, sys.argv[1]) if len(sys.argv) == 2 else None
if not match or len(sys.argv[1]) > 128:
    sys.exit('Expected a v-prefixed SemVer tag, such as v1.2.3 or v1.2.3-rc.1')
print('latest=false' if match['pre'] else 'latest=true')
# Underscore is allowed in Docker tags but not SemVer, so build metadata cannot
# collide with a prerelease tag (v1.2.3+build.1 versus v1.2.3-build.1).
print('tag=' + sys.argv[1].replace('+', '_'))
