#!/usr/bin/env bash
# A disposable GitHub-hosted Ubuntu 24.04 cluster, never a developer database.
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && -n "${RUNNER_TEMP:-}" ]]
# shellcheck source=/dev/null
. /etc/os-release
[[ "$ID" == ubuntu && "$VERSION_ID" == 24.04 ]]
key="$RUNNER_TEMP/pgdg.asc"
curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc -o "$key"
fingerprint=$(gpg --show-keys --with-colons "$key" | awk -F: '$1 == "fpr" { print $10; exit }')
[[ "$fingerprint" == B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8 ]]
sudo install -m 644 "$key" /usr/share/keyrings/pinakes-pgdg.asc
printf '%s\n' 'deb [signed-by=/usr/share/keyrings/pinakes-pgdg.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main' | sudo tee /etc/apt/sources.list.d/pinakes-pgdg.list >/dev/null
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
  postgresql-16 postgresql-client-16 postgresql-16-postgis-3 postgresql-contrib-16 \
  postgresql-16-h3=4.2.3-4.pgdg24.04+1 ripgrep prometheus shellcheck python3-venv
# This cluster's local socket accepts the disposable CI role from test containers too.
# TCP remains on loopback and password-authenticated. No production credentials exist here.
# Keep the name free of dashes: systemd's %I turns them into path separators.
sudo pg_createcluster 16 pinakesci --port=55432 --start -- --auth-local=trust --auth-host=scram-sha-256
sudo -u postgres /usr/lib/postgresql/16/bin/createuser -p 55432 --superuser pinakes_ci
/usr/lib/postgresql/16/bin/psql -X -v ON_ERROR_STOP=1 -p 55432 -U pinakes_ci -d postgres <<'SQL'
CREATE EXTENSION postgis;
CREATE EXTENSION pg_trgm;
CREATE EXTENSION h3;
DO $$ BEGIN
  IF (SELECT extversion FROM pg_extension WHERE extname = 'h3') <> '4.2.3' THEN
    RAISE EXCEPTION 'CI requires h3 4.2.3';
  END IF;
  IF postgis_lib_version()::text < '3.4' THEN
    RAISE EXCEPTION 'CI requires PostGIS >= 3.4';
  END IF;
  PERFORM h3_latlng_to_cell(point(52.52, 13.405), 7);
END $$;
SELECT version(), postgis_lib_version(), extversion AS h3_version
FROM pg_extension WHERE extname = 'h3';
SQL
# Use the matching client tools, even when the runner has other PG majors installed.
printf '%s\n' /usr/lib/postgresql/16/bin >> "$GITHUB_PATH"
