#!/usr/bin/env bash
# A disposable GitHub-hosted Ubuntu 24.04 cluster, never a developer database.
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && -n "${RUNNER_TEMP:-}" ]]
# shellcheck source=/dev/null
. /etc/os-release
[[ "$ID" == ubuntu && "$VERSION_ID" == 24.04 ]]
# When the runner cannot resolve its Ubuntu archive hosts (a DNS incident on hosted runners),
# point apt's Ubuntu sources at a mirror outside ubuntu.com. A no-op while they resolve; packages
# are still checked against the archive keyring the sources name. PGDG below is not touched.
ubuntu_archive='https?://([A-Za-z0-9-]+\.)*ubuntu\.com/ubuntu(-ports)?/?'
apt_files=()
for file in /etc/apt/apt-mirrors.txt /etc/apt/sources.list /etc/apt/sources.list.d/*.sources \
  /etc/apt/sources.list.d/*.list; do
  if [[ -f "$file" ]]; then apt_files+=("$file"); fi
done
unresolved=()
if ((${#apt_files[@]})); then
  while read -r host; do
    timeout 10 getent hosts "$host" >/dev/null || unresolved+=("$host")
  done < <(grep -ohE "$ubuntu_archive" "${apt_files[@]}" | sed -E 's#^https?://##; s#/.*##' | sort -u)
fi
if ((${#unresolved[@]})); then
  case "$(dpkg --print-architecture)" in
    amd64 | i386) archive=ubuntu ;;
    *) archive=ubuntu-ports ;;
  esac
  mirror=
  for base in https://mirrors.edge.kernel.org https://mirrors.mit.edu https://mirrors.ocf.berkeley.edu; do
    for suite in "$VERSION_CODENAME" "$VERSION_CODENAME-updates" "$VERSION_CODENAME-security"; do
      curl --fail --silent --head --max-time 20 -o /dev/null "$base/$archive/dists/$suite/InRelease" ||
        continue 2
    done
    mirror="$base/$archive/"
    break
  done
  if [[ -n "$mirror" ]]; then
    echo "::warning::apt: cannot resolve ${unresolved[*]}; using the Ubuntu mirror $mirror"
    for file in "${apt_files[@]}"; do
      sudo sed -i -E "s#$ubuntu_archive#$mirror#g" "$file"
    done
  else
    echo "::warning::apt: cannot resolve ${unresolved[*]} and no fallback mirror answers; keeping the runner's sources"
  fi
else
  echo "apt: using the runner's Ubuntu sources"
fi
key="$RUNNER_TEMP/pgdg.asc"
curl --fail --silent --show-error https://www.postgresql.org/media/keys/ACCC4CF8.asc -o "$key"
fingerprint=$(gpg --show-keys --with-colons "$key" | awk -F: '$1 == "fpr" { print $10; exit }')
[[ "$fingerprint" == B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8 ]]
sudo install -m 644 "$key" /usr/share/keyrings/pinakes-pgdg.asc
printf '%s\n' \
  'deb [signed-by=/usr/share/keyrings/pinakes-pgdg.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main' |
  sudo tee /etc/apt/sources.list.d/pinakes-pgdg.list >/dev/null
sudo apt-get update
sudo apt-get install -y --no-install-recommends \
  postgresql-16 postgresql-client-16 postgresql-16-postgis-3 postgresql-contrib-16 \
  ripgrep prometheus shellcheck python3-venv
# This cluster's local socket accepts the disposable CI role from test containers too.
# TCP remains on loopback and password-authenticated. No production credentials exist here.
# Keep the name free of dashes: systemd's %I turns them into path separators.
sudo pg_createcluster 16 pinakesci --port=55432 --start -- --auth-local=trust --auth-host=scram-sha-256
sudo -u postgres /usr/lib/postgresql/16/bin/createuser -p 55432 --superuser pinakes_ci
/usr/lib/postgresql/16/bin/psql -X -v ON_ERROR_STOP=1 -p 55432 -U pinakes_ci -d postgres <<'SQL'
CREATE EXTENSION postgis;
CREATE EXTENSION pg_trgm;
-- Versions compare as numbers (as text, '3.10' sorts before '3.4'); a missing one fails.
DO $$ BEGIN
  IF coalesce((string_to_array(postgis_lib_version(), '.'))[1:2]::int[], '{}') < ARRAY[3, 4] THEN
    RAISE EXCEPTION 'CI requires PostGIS >= 3.4';
  END IF;
END $$;
SELECT version(), postgis_lib_version();
SQL
# Use the matching client tools, even when the runner has other PG majors installed.
printf '%s\n' /usr/lib/postgresql/16/bin >> "$GITHUB_PATH"
