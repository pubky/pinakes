#!/usr/bin/env bash
# Publish only a commit that main itself pointed to. The tag's workflow comes from the tagged
# commit, so this stops mistaken tags, not hostile ones: the v* tag ruleset does that
# (docs/deployment.md). Read-only; runs before any registry login.
# stdout is the step output `commit=<sha>`: the one commit every image tag of this release names.
set -euo pipefail
fail() { printf '::error::%s\n' "$1" >&2; exit 1; }
[[ "${GITHUB_SHA:-}" =~ ^[0-9a-f]{40}$ ]] || fail 'GITHUB_SHA must be a full object ID'
# GitHub documents GITHUB_SHA as the tip commit; an annotated tag's object would also peel here.
# Anything that does not peel to a commit (a tree or blob tag, an unknown object) stops here.
commit=$(git rev-parse --verify --quiet "$GITHUB_SHA^{commit}") || fail "$GITHUB_SHA is not a commit or a tag of one"
# The build context is the checked-out tree: it must be the commit the images will name.
head=$(git rev-parse --verify --quiet 'HEAD^{commit}') || fail 'nothing is checked out'
[[ "$head" == "$commit" ]] || fail "checked-out commit $head is not the tagged commit $commit"
# checkout's fetch-depth 0 fetched every branch into refs/remotes/origin in this job.
[[ "$(git rev-parse --is-shallow-repository)" == false ]] || fail 'history is shallow; fetch with depth 0'
main=$(git rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}') || fail 'origin/main was not fetched'
git merge-base --is-ancestor "$commit" "$main" || fail "Tagged commit $commit is not on main ($main); nothing is published."
# Merged branches bring their own commits into main's history; only main's first-parent
# line holds states main was at. grep reads all input, so pipefail sees no SIGPIPE.
git rev-list --first-parent "$main" | grep --fixed-strings --line-regexp "$commit" >/dev/null ||
  fail "Tagged commit $commit only reached main inside a merged branch; tag the merge."
printf 'Tagged commit %s is on main (%s).\n' "$commit" "$main" >&2
printf 'commit=%s\n' "$commit"
