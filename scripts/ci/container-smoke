#!/usr/bin/env bash
# Run only on a disposable Linux CI runner after setup-postgres and the image build.
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && -n "${RUNNER_TEMP:-}" ]]
image="${1:-pinakes:ci}"
name="pinakes-smoke-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
volume="${name}-dumps"
psql "$DATABASE_URL" -X -v ON_ERROR_STOP=1 -c 'CREATE DATABASE pinakes_container_smoke'
# A local-only test socket, with no passwords or registry credentials.
smoke_db='postgresql:///pinakes_container_smoke?host=/run/postgresql&port=55432&user=pinakes_ci'
cleanup() {
  local status=$?
  docker logs "$name" || true
  docker rm --force "$name" >/dev/null || true
  docker volume rm "$volume" >/dev/null || true
  exit "$status"
}
trap cleanup EXIT
printf '[http]\ncontact = "ci@example.invalid"\n' > "$RUNNER_TEMP/pinakes-smoke.toml"
chmod 644 "$RUNNER_TEMP/pinakes-smoke.toml"
docker run --detach --name "$name" \
  --read-only --cap-drop ALL --security-opt no-new-privileges \
  --tmpfs /tmp:rw,noexec,nosuid,size=64m \
  --mount type=bind,source=/var/run/postgresql,target=/run/postgresql,readonly \
  --mount "type=bind,source=$RUNNER_TEMP/pinakes-smoke.toml,target=/etc/pinakes/pinakes.toml,readonly" \
  --mount "type=volume,source=$volume,target=/var/lib/pinakes/dumps" \
  --publish 127.0.0.1:8090:8090 \
  --env "PINAKES__DATABASE_URL=$smoke_db" \
  --env PINAKES__NEXUS_URL=http://127.0.0.1:1 \
  --env PINAKES__CANARY__ENABLED=false \
  "$image" --config /etc/pinakes/pinakes.toml
ready=false
for _ in {1..60}; do
  if curl --fail --silent http://127.0.0.1:8090/v1/info > "$RUNNER_TEMP/pinakes-info.json"; then
    ready=true
    break
  fi
  sleep 1
done
[[ "$ready" == true ]]
curl --fail --silent --show-error 'http://127.0.0.1:8090/v1/search?limit=1' > "$RUNNER_TEMP/pinakes-search.json"
# The ODbL dump is written from the real database and persisted in the mounted volume.
ready=false
for _ in {1..30}; do
  if curl --fail --silent http://127.0.0.1:8090/v1/dumps/osm_place.ndjson.gz > "$RUNNER_TEMP/pinakes-osm.gz"; then
    ready=true
    break
  fi
  sleep 1
done
[[ "$ready" == true ]]
[[ "$(docker exec "$name" id -u)" == 10001 ]]
# The image's HEALTHCHECK asks the admin listener's /healthz, which reads the database.
[[ "$(docker image inspect "$image" --format '{{json .Config.Healthcheck.Test}}')" == '["CMD","/usr/local/bin/pinakesd","healthcheck"]' ]]
[[ "$(docker exec "$name" /usr/local/bin/pinakesd healthcheck)" == healthy ]]
[[ "$(docker image inspect "$image" --format '{{json .Config.ExposedPorts}}')" == '{"8090/tcp":{}}' ]]
# /proc stores IPv4 in little endian. 2382 is port 9090: it must bind loopback only.
docker exec "$name" cat /proc/net/tcp > "$RUNNER_TEMP/pinakes-tcp.txt"
python3 - "$RUNNER_TEMP" <<'PY'
import gzip
import json
from pathlib import Path
import sys
p = Path(sys.argv[1])
assert json.loads((p / 'pinakes-info.json').read_text())['version']
assert isinstance(json.loads((p / 'pinakes-search.json').read_text()), dict)
notice = json.loads(gzip.decompress((p / 'pinakes-osm.gz').read_bytes()).splitlines()[0])
assert notice['licence'] == 'ODbL-1.0'
listeners = [line.split()[1] for line in (p / 'pinakes-tcp.txt').read_text().splitlines()[1:]
             if line.split()[3] == '0A']
assert '0100007F:2382' in listeners, listeners
assert all(v == '0100007F:2382' for v in listeners if v.endswith(':2382')), listeners
PY
# SIGTERM is a graceful shutdown: every task must finish and the daemon exit 0.
docker stop --time 30 "$name" >/dev/null
exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$name")
[[ "$exit_code" == 0 ]] || { printf 'pinakesd exited %s after SIGTERM\n' "$exit_code" >&2; exit 1; }
printf '%s\n' 'Container smoke passed: nonroot release daemon, real schema/API/dump, loopback admin, clean stop.'
