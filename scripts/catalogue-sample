#!/usr/bin/env bash
# Import a small real sample of a catalogue into a throwaway database and check it end to end:
# the real `pinakesd catalogue import` path, row counts, keys, labels, canonical links, a text
# search through `/v1/search`, shared links joining their cards through `POST /v1/resolve`, an
# update that rewrites only the changed rows, and the catalogue switched off leaving search at once.
#
# usage: scripts/catalogue-sample musicbrainz [--keep] [--import-only] [--bytes ENTITY=N]...
#        scripts/catalogue-sample openalex|podcastindex|software|tranco [--keep]
#
# Each catalogue's sample and its options: scripts/catalogue/sample-musicbrainz (MusicBrainz's
# dumps) and scripts/catalogue/sample-files (the catalogues that read files). Both take the same
# environment (PINAKESD, PGHOST, PGPORT, SAMPLE_DB, SAMPLE_DIR, PINAKES__HTTP__CONTACT).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
case ${1:-} in
  musicbrainz) exec "$here/catalogue/sample-musicbrainz" "$@" ;;
  openalex|podcastindex|software|tranco) exec "$here/catalogue/sample-files" "$@" ;;
  *) echo "usage: $0 musicbrainz|openalex|podcastindex|software|tranco [options]" >&2; exit 2 ;;
esac
